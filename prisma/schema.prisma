generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProposalType {
  REGULAR
  VEHICLE
}

model File {
  id            Int            @id @default(autoincrement())
  filename      String
  mimeType      String
  fileSize      Int
  data          Bytes
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  proposals     Proposal[]
  leaveRequests LeaveRequest[] @relation("LeaveRequestHandoverFile")

  @@index([createdAt])
}

model Vehicle {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  plateNumber String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isBusy      Boolean  @default(false)

  proposals Proposal[]
}

model Employee {
  id                   Int                         @id @default(autoincrement())
  employeeCode         String                      @unique
  name                 String
  gender               Sex                         @default(MALE)
  birthDate            DateTime?
  password             String
  role                 Role                        @default(USER)
  avatar               String?
  isActive             Boolean                     @default(true)
  managerId            Int?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  AttendanceImportLog  AttendanceImportLog[]       @relation("EmployeeImportLogs")
  contactInfo          ContactInfo?
  departmentDirectorOf Department?                 @relation("DepartmentDirector")
  departmentHeadOf     Department?                 @relation("DepartmentHead")
  manager              Employee?                   @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates         Employee[]                  @relation("EmployeeManager")
  KPIEmployee          KPIEmployee[]
  LeaveApprovalSteps   LeaveApprovalStepApprover[] @relation("ApproverSteps")
  LeaveRequest         LeaveRequest[]
  proposalsCreated     Proposal[]                  @relation("ProposalCreatedBy")
  proposalsProposed    Proposal[]                  @relation("ProposalProposer")
  proposalApprovals    ProposalApprover[]
  proposalSignatures   ProposalSigner[]
  workInfo             WorkInfo?
  Attendance           Attendance[]

  assetsReceived     AssetAssignment[]   @relation("EmployeeAsset")
  assetsIssued       AssetAssignment[]   @relation("IssuedAssets")
  compensatoryLeaves CompensatoryLeave[]
  salaries           Salary[]
  salaryBatches      SalaryBatch[]

  @@index([employeeCode])
  @@index([managerId])
}

model Department {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  abbreviation String     @unique
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  headId       Int?       @unique
  directorId   Int?       @unique
  director     Employee?  @relation("DepartmentDirector", fields: [directorId], references: [id])
  head         Employee?  @relation("DepartmentHead", fields: [headId], references: [id])
  positions    Position[]
  workInfos    WorkInfo[]
}

model Position {
  id           Int        @id @default(autoincrement())
  name         String
  level        Int        @default(1)
  description  String?
  departmentId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  employees    WorkInfo[]

  @@index([departmentId])
}

model WorkInfo {
  id              Int         @id @default(autoincrement())
  departmentId    Int?
  positionId      Int?
  specialization  String?
  joinedTBD       DateTime?
  joinedTeSCC     DateTime?
  seniorityStart  DateTime?
  seniority       String?
  contractNumber  String?
  contractDate    DateTime?
  contractType    String?
  contractEndDate DateTime?
  employeeId      Int         @unique
  department      Department? @relation(fields: [departmentId], references: [id])
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position        Position?   @relation(fields: [positionId], references: [id])

  @@index([departmentId])
  @@index([positionId])
}

model ContactInfo {
  id            Int      @id @default(autoincrement())
  phoneNumber   String?  @unique
  relativePhone String?
  companyPhone  String?
  email         String?
  employeeId    Int      @unique
  zalo_user_id  String?  @unique(map: "zalo_user_id") @db.VarChar(255)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id            Int                 @id @default(autoincrement())
  employeeId    Int
  leaveType     LeaveTypeEnum
  startDate     DateTime
  endDate       DateTime
  totalHours    Float?
  reason        String?             @db.LongText
  status        LeaveStatus         @default(pending)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  approvalSteps LeaveApprovalStep[]
  employee      Employee            @relation(fields: [employeeId], references: [id])

  // ⭐ New: chỉ một file biên bản bàn giao
  handoverFileId Int?
  handoverFile   File? @relation("LeaveRequestHandoverFile", fields: [handoverFileId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model LeaveApprovalStep {
  id             Int                         @id @default(autoincrement())
  leaveRequestId Int
  level          Int
  status         LeaveStatus                 @default(pending)
  approvedAt     DateTime?
  leaveRequest   LeaveRequest                @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approvers      LeaveApprovalStepApprover[]

  @@unique([leaveRequestId, level])
}

model LeaveApprovalStepApprover {
  id                  Int               @id @default(autoincrement())
  leaveApprovalStepId Int
  approverId          Int
  status              LeaveStatus       @default(pending)
  approvedAt          DateTime?
  approver            Employee          @relation("ApproverSteps", fields: [approverId], references: [id])
  leaveApprovalStep   LeaveApprovalStep @relation(fields: [leaveApprovalStepId], references: [id], onDelete: Cascade)

  @@unique([leaveApprovalStepId, approverId])
  @@index([approverId], map: "LeaveApprovalStepApprover_approverId_fkey")
}

model AttendanceImportLog {
  id           Int          @id @default(autoincrement())
  filename     String
  importedAt   DateTime     @default(now())
  importedById Int?
  attendances  Attendance[]
  importedBy   Employee?    @relation("EmployeeImportLogs", fields: [importedById], references: [id])

  @@index([importedById], map: "AttendanceImportLog_importedById_fkey")
}

model Attendance {
  id           Int                  @id @default(autoincrement())
  employeeId   Int
  date         DateTime             @db.Date
  checkInTime  DateTime?
  checkOutTime DateTime?
  workingHours Float?
  importId     Int?
  importLog    AttendanceImportLog? @relation(fields: [importId], references: [id])
  employee     Employee             @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([importId], map: "Attendance_importId_fkey")
}

model KPI {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  period       String
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  kpiEmployees KPIEmployee[]
}

model KPIEmployee {
  id         Int        @id @default(autoincrement())
  kpiId      Int
  employeeId Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  employee   Employee   @relation(fields: [employeeId], references: [id])
  kpi        KPI        @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  entries    KPIEntry[]

  @@unique([kpiId, employeeId])
  @@index([employeeId], map: "KPIEmployee_employeeId_fkey")
}

model KPIEntry {
  id            Int         @id @default(autoincrement())
  kpiEmployeeId Int
  name          String
  targetValue   Float
  achievedValue Float       @default(0)
  isAchieved    Boolean     @default(false)
  weight        Float       @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  kpiEmployee   KPIEmployee @relation(fields: [kpiEmployeeId], references: [id], onDelete: Cascade)

  @@unique([kpiEmployeeId, name])
}

model Proposal {
  id          Int            @id @default(autoincrement())
  name        String
  title       String
  description String?        @db.Text
  fileId      Int?
  status      ProposalStatus @default(pending_signatures)
  proposerId  Int
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  proposalType ProposalType @default(REGULAR)
  vehicleId    Int?
  startAt      DateTime?
  endAt        DateTime?
  dropoffPlace String?

  vehicle   Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy Employee           @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  file      File?              @relation(fields: [fileId], references: [id])
  proposer  Employee           @relation("ProposalProposer", fields: [proposerId], references: [id])
  approvers ProposalApprover[]
  signers   ProposalSigner[]

  @@index([status])
  @@index([proposerId])
  @@index([createdById])
  @@index([fileId])
  @@index([proposalType])
  @@index([vehicleId])
}

model ProposalSigner {
  id         Int         @id @default(autoincrement())
  proposalId Int
  signerId   Int
  status     LeaveStatus @default(pending)
  reason     String?     @db.Text
  signedAt   DateTime?
  level      Int
  proposal   Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  signer     Employee    @relation(fields: [signerId], references: [id])

  @@unique([proposalId, signerId])
  @@index([signerId], map: "ProposalSigner_signerId_fkey")
}

model ProposalApprover {
  id         Int         @id @default(autoincrement())
  proposalId Int
  approverId Int
  reason     String?     @db.Text
  status     LeaveStatus @default(pending)
  level      Int?
  approvedAt DateTime?
  approver   Employee    @relation(fields: [approverId], references: [id])
  proposal   Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, approverId])
  @@index([approverId], map: "ProposalApprover_approverId_fkey")
}

model EmailActionToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  proposalId Int
  actorId    String
  role       String
  action     String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
}

model Asset {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AssetAssignment[]
}

model AssetAssignment {
  id         Int      @id @default(autoincrement())
  assetId    Int
  employeeId Int
  issuedById Int?
  issuedAt   DateTime @default(now())
  quantity   Int      @default(1)
  note       String?

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  // Thêm map: "FK_EmployeeAsset" để định danh riêng biệt
  employee Employee  @relation("EmployeeAsset", fields: [employeeId], references: [id], onDelete: Cascade, map: "FK_AssetAssignment_Employee")
  // Thêm map: "FK_IssuedAssets"
  issuedBy Employee? @relation("IssuedAssets", fields: [issuedById], references: [id], onDelete: SetNull, map: "FK_AssetAssignment_Issuer")

  @@index([employeeId])
  @@index([issuedById])
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum WorkStatus {
  OFFICIAL
  PROBATION
  RESIGNED
}

enum LeaveTypeEnum {
  PN
  NB
  PC
  PT
  Cgt
  PB
  TS
  PR
}

enum LeaveStatus {
  pending
  approved
  rejected
  revoked
}

enum ProposalStatus {
  pending_signatures
  waiting_approval
  approved
  rejected
}

enum NotificationType {
  MAINTENANCE
  SYSTEM
  HR
  SECURITY
  FEATURE
  CUSTOM
}

model Notification {
  id      Int              @id @default(autoincrement())
  title   String?
  message String           @db.LongText
  type    NotificationType

  startTime DateTime? // nullable
  endTime   DateTime? // nullable

  isActive    Boolean  @default(true)
  sendMail    Boolean  @default(false)
  sendApp     Boolean  @default(true)
  mailContent String?  @db.Text // nội dung email (HTML / text) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([startTime, endTime])
}

model CompensatoryLeave {
  id         Int       @id @default(autoincrement())
  employeeId Int
  workDate   DateTime  @db.Date // Chủ nhật đã đi làm
  grantedAt  DateTime  @default(now()) // Ngày cấp nghỉ bù
  used       Boolean   @default(false) // Đã dùng hay chưa
  usedAt     DateTime?
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate]) // ❗ tránh cấp trùng
  @@index([employeeId])
  @@index([used])
}

model LunchMenu {
  id         Int      @id @default(autoincrement())
  dayOfWeek  String // "Thứ 2", "Thứ 3", ... hoặc dùng Enum DayOfWeek
  salty      String // Món mặn
  vegetarian String // Món chay
  stir       String // Món xào
  soup       String // Món canh
  dessert    String // Tráng miệng
  weekNumber Int? // Tuần thứ mấy trong năm (để quản lý theo tuần)
  year       Int? // Năm
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([weekNumber, year])
}

model Salary {
  id Int @id @default(autoincrement())

  // ===== QUẢN LÝ =====
  batchId    Int?
  employeeId Int
  month      Int
  year       Int
  type       String // STAFF / MANAGER

  // ===== THÔNG TIN NHÂN VIÊN =====
  employeeCode   String
  fullName       String
  position       String?
  grade          String? // Ngạch nhân viên
  insuranceLevel String? // Bậc đóng BHXH
  contractDate   DateTime? // Ngày ký HĐLĐ
  workingDays    Float     @default(0)
  notOfficial    Float     @default(0) // Chưa ký chính thức

  // ===== LƯƠNG CỐ ĐỊNH =====
  baseSalary       Float @default(0) // Lương BHXH + PC
  efficiencySalary Float @default(0)
  salary70         Float @default(0)

  // ===== PHỤ CẤP =====
  phoneAllowance     Float @default(0)
  seniorityAllowance Float @default(0)
  mealAllowance      Float @default(0)
  maternityAllowance Float @default(0)
  houseAllowance     Float @default(0) // Phụ cấp thuê nhà

  // ===== NĂNG SUẤT =====
  productivitySalary    Float @default(0)
  productivityOther     Float @default(0)
  productivitySCC       Float @default(0)
  productivityPaint     Float @default(0)
  productivityAccessory Float @default(0)
  productivityParts     Float @default(0)

  // ===== THƯỞNG & CỘNG THÊM =====
  bonusDay10   Float @default(0)
  salaryAdjust Float @default(0) // Bù lương
  bonusDay25   Float @default(0)
  otherWork    Float @default(0)
  bonus        Float @default(0)
  overtime     Float @default(0)
  otherIncome  Float @default(0)

  // ===== KHẤU TRỪ =====
  salaryDeduction      Float @default(0) // Trừ lương (đầu sheet)
  insuranceDeduction   Float @default(0) // BHXH-YT 9.5%
  unemploymentInsu     Float @default(0) // BHTN 1%
  unionFee             Float @default(0) // Công đoàn
  advancePayment       Float @default(0)
  socialWorkDeduction  Float @default(0)
  healthCardDeduction  Float @default(0)
  insuranceArrears     Float @default(0)
  taxCompensation      Float @default(0) // Nộp bù thuế
  taxTNCN              Float @default(0)
  phoneDeduction       Float @default(0)
  taxRefund            Float @default(0) // Hoàn thuế
  salaryDeductionFinal Float @default(0) // Trừ lương cuối sheet

  // ===== TỔNG =====
  totalGross Float @default(0) // TỔNG LƯƠNG (1)
  totalNet   Float @default(0) // TỔNG LƯƠNG (2)

  // ===== THỰC NHẬN =====
  firstReceived  Float @default(0)
  bonusReceived  Float @default(0) // ĐÃ NHẬN THƯỞNG
  actualReceived Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  batch    SalaryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year, type])
  @@index([employeeCode])
}

model SalaryBatch {
  id          Int      @id @default(autoincrement())
  filename    String
  month       Int
  year        Int
  totalRows   Int      @default(0)
  status      String   @default("success") // success, failed
  createdById Int
  createdAt   DateTime @default(now())

  // Quan hệ: 1 Batch có nhiều dòng lương
  salaries  Salary[]
  createdBy Employee @relation(fields: [createdById], references: [id])

  @@index([month, year])
}
